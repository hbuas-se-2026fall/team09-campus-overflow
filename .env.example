# CampusOverflow 本地环境变量模板（复制为 .env 后按需修改；.env 不入库）
# Windows 若遇到 Hyper-V 动态保留端口占用 5432/6379，可改用高位端口（如 15432 / 16379）

DB_PORT=5432
REDIS_PORT=16379

DATABASE_URL=postgresql+asyncpg://campus:campus@localhost:5432/campus
REDIS_URL=redis://localhost:16379/0
CELERY_BROKER_URL=redis://localhost:16379/1
# JWT_SECRET=dev-secret-change-me-in-production
# DB_POOL_SIZE=0
